{
  "id": "mal-friend-stats",
  "name": "MAL Friend Stats",
  "version": "1.0.1",
  "manifestURI": "https://raw.githubusercontent.com/bruuhim/bruuhim-seanime-extensions/main/src/mal-friend-stats/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Shows which of your MyAnimeList friends are watching or have rated the anime you're viewing",
  "author": "Bruuhim",
  "icon": "https://raw.githubusercontent.com/bruuhim/bruuhim-seanime-extensions/main/assets/friend-stats.png",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/bruuhim/bruuhim-seanime-extensions/main/src/mal-friend-stats/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["anilist", "database", "storage", "anilist-token", "system", "network"],
      "allow": {
        "commandScopes": [
          {
            "command": "cmd",
            "args": [
              { "value": "/c" },
              { "value": "start" },
              { "validator": "^https://myanimelist\\.net/profile/.*$" }
            ]
          },
          {
            "command": "open",
            "args": [
              { "validator": "^https://myanimelist\\.net/profile/.*$" }
            ]
          },
          {
            "command": "xdg-open",
            "args": [
              { "validator": "^https://myanimelist\\.net/profile/.*$" }
            ]
          }
        ],
        "urls": ["https://api.jikan.moe/v4/*", "https://myanimelist.net/*"]
      }
    }
  },
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "malUsername",
        "label": "MAL Username",
        "type": "text",
        "default": ""
      }
    ]
  },
  "isDevelopment": false
}
